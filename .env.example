# Skopiuj ten plik jako .env.local i uzupełnij wartości.
# Klucz z https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Nazwa modelu z https://openrouter.ai/models, np. dostawca/model
OPENROUTER_MODEL=

# Hasło warsztatowe do wejścia na czat
CHAT_PASSWORD=
# Losowy sekret do podpisywania sesji (min. 32 znaki). Nie udostępniaj go.
SESSION_SECRET=
